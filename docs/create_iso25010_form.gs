/**
 * Creates the updated TrainWise ISO/IEC 25010:2023 evaluation form.
 *
 * How to use:
 * 1. Go to https://script.google.com and create a new project.
 * 2. Delete the placeholder code and paste this entire file in.
 * 3. Click "Run" (the play button) on the createTrainWiseIsoForm function.
 * 4. The first run will ask you to authorize the script (it only needs
 *    permission to create a Google Form in your own account).
 * 5. Open "Executions" (left sidebar) or the Logger output to grab the
 *    two URLs it prints: one to edit the form, one to send to respondents.
 *
 * Covers all 9 ISO/IEC 25010:2023 characteristics and every one of their
 * sub-characteristics (40 questions total), each described in terms of
 * an actual TrainWise feature rather than generic boilerplate. Also
 * includes the standard LSPU / College of Computer Studies header banner,
 * project title, researcher names, and instructions block, matching the
 * format used by the other capstone groups' questionnaires.
 */

// Base64-encoded header banner (LSPU + CCS seals with the campus/college
// name between them) so the whole form is self-contained in this one
// file - no manual image upload to Google Drive needed.
var HEADER_BANNER_BASE64 = '';

function createTrainWiseIsoForm() {
  var form = FormApp.create('TrainWise System Evaluation — ISO/IEC 25010:2023 Software Quality Assessment');

  form.setCollectEmail(true);
  form.setIsQuiz(false);

  // ---- Header banner (LSPU + CCS seals) ----
  var bannerBlob = Utilities.newBlob(
    Utilities.base64Decode(HEADER_BANNER_BASE64),
    'image/png',
    'header_banner.png'
  );
  form.addImageItem().setImage(bannerBlob);

  // ---- Project title / researchers / greeting / purpose / instructions ----
  form.addSectionHeaderItem()
    .setTitle('Project Title')
    .setHelpText('TRAINWISE: A WEB AND MOBILE-BASED EMPLOYEE TRAINING NEEDS ASSESSMENT AND RECOMMENDATION SYSTEM USING XGBOOST AND NATURAL LANGUAGE PROCESSING');

  form.addSectionHeaderItem()
    .setTitle('The Researchers')
    .setHelpText('Sean John R. Looc, Gian Carlo I. Maranan, Brenderick I. Amparo Jr., and Klyde Cisco T. Canapi');

  form.addSectionHeaderItem()
    .setTitle('Good Day!')
    .setHelpText(
      'We are 4th year students, currently pursuing a Bachelor of Science in ' +
      'Information Technology specializing in Web and Mobile Application ' +
      'Development (WMAD). As part of our academic endeavors, we have ' +
      'developed a web and mobile based system adhering to the ISO/IEC ' +
      '25010:2023 software product quality standard.'
    );

  form.addSectionHeaderItem()
    .setTitle('Purpose')
    .setHelpText(
      'To assess the effectiveness and user satisfaction of our system, we ' +
      'have devised a set of questions covering all nine ISO/IEC 25010:2023 ' +
      'quality characteristics. Your responses, rated on a scale from 1 to 5, ' +
      'will help us evaluate various aspects of the system, from functionality ' +
      'and security to overall user experience.'
    );

  form.addSectionHeaderItem()
    .setTitle('Instructions')
    .setHelpText(
      'Please rate each item below on the 5-point scale provided for each ' +
      'criterion, where 5 = Excellent, 4 = Good, 3 = Fair, 2 = Needs ' +
      'Improvement, and 1 = Poor.'
    );

  form.addTextItem().setTitle('Full Name and Position').setRequired(true);

  var sections = [
    {
      title: 'Functional Suitability',
      items: [
        {
          title: 'Functional Completeness',
          description: 'TrainWise supports all core functions its users need: submitting the Training Needs Assessment, generating AI based training recommendations, creating and processing Individual Development Plans, managing the training demand pipeline from dean sourcing to HR approval, completing evaluations, and delivering notifications.'
        },
        {
          title: 'Functional Correctness',
          description: 'Features produce accurate results. Assessment submissions are recorded correctly, AI recommendations reflect the employee\'s actual profile and assessment answers, and training statuses such as Recommended, Accepted, Training Found, Confirmed, and Completed transition correctly as deans and HR act on them.'
        },
        {
          title: 'Functional Appropriateness',
          description: 'Functions match each user role\'s actual workflow. Employees submit assessments and manage their own recommendations, deans review and source trainings for their college, and HR Admins approve, confirm, and track training demand system wide.'
        }
      ]
    },
    {
      title: 'Performance Efficiency',
      items: [
        {
          title: 'Time Behaviour',
          description: 'Dashboards, the AI recommendation list, and generated reports load and respond within an acceptable time, even while the recommendation engine is scoring a submission.'
        },
        {
          title: 'Resource Utilization',
          description: 'The system uses server memory, database queries, and network bandwidth efficiently, without unnecessary strain, including during calls to the separate machine learning recommendation service.'
        },
        {
          title: 'Capacity',
          description: 'The system continues to perform acceptably as the number of registered employees, submitted assessments, and pooled training demand records grows over time.'
        }
      ]
    },
    {
      title: 'Compatibility',
      items: [
        {
          title: 'Co-existence',
          description: 'TrainWise runs without conflicting with other applications, browser extensions, or services on the same device or hosting environment.'
        },
        {
          title: 'Interoperability',
          description: 'The system correctly exchanges data with its own machine learning microservice over HTTP, and correctly processes uploaded files such as profile photos, IDP signatures, and proof of completion documents.'
        }
      ]
    },
    {
      title: 'Interaction Capability',
      items: [
        {
          title: 'Appropriateness Recognizability',
          description: 'Users can tell right away, just from the dashboard and menu labels, whether TrainWise can help with the training need they have.'
        },
        {
          title: 'Learnability',
          description: 'New employees can learn to submit an assessment or check their recommendations without needing a manual or a training session.'
        },
        {
          title: 'Operability',
          description: 'Common tasks such as submitting an assessment, accepting a recommendation, or uploading proof of completion can be finished with minimal clicks and no confusing steps.'
        },
        {
          title: 'User Error Protection',
          description: 'The system helps prevent mistakes before they cause harm, such as validating required profile fields and confirming with the employee before a late assessment submission goes through.'
        },
        {
          title: 'User Engagement',
          description: 'The interface, including the dashboard cards, calendar, and progress indicators, invites users to actually check in and act rather than just passively view information.'
        },
        {
          title: 'Inclusivity',
          description: 'TrainWise stays usable for employees with different levels of digital literacy and for users on different devices, screen sizes, and connection speeds.'
        },
        {
          title: 'User Assistance',
          description: 'Helpful cues such as placeholder text, inline hints, confirmation messages, and clear error explanations guide users through less familiar tasks like completing an Individual Development Plan.'
        },
        {
          title: 'Self-Descriptiveness',
          description: 'Screens and status labels, such as Forwarded to HR or Training Found, clearly explain what they mean without the user needing to ask someone else.'
        }
      ]
    },
    {
      title: 'Reliability',
      items: [
        {
          title: 'Faultlessness',
          description: 'The system runs consistently without frequent errors, crashes, or unexpected behavior during normal use.'
        },
        {
          title: 'Availability',
          description: 'TrainWise stays accessible to employees, deans, and HR Admins whenever they need to use it.'
        },
        {
          title: 'Fault Tolerance',
          description: 'The system keeps functioning correctly even if a dependent component, such as the machine learning recommendation service, becomes temporarily unreachable.'
        },
        {
          title: 'Recoverability',
          description: 'If a submission or update gets interrupted, TrainWise preserves the user\'s data and returns to a consistent state instead of losing information.'
        }
      ]
    },
    {
      title: 'Security',
      items: [
        {
          title: 'Confidentiality',
          description: 'Employee, dean, and HR data is only accessible to users who are authorized to see it, enforced through role based session checks.'
        },
        {
          title: 'Integrity',
          description: 'Data such as assessment answers, training statuses, and recommendation records cannot be changed except through the system\'s own authorized actions.'
        },
        {
          title: 'Non-repudiation',
          description: 'Actions such as approving a training demand or confirming a participant are recorded in a way that ties them to the specific HR Admin or dean who performed them.'
        },
        {
          title: 'Accountability',
          description: 'The system\'s audit log records key actions such as approvals, status changes, and uploads, so activity can be traced back to a specific user and time.'
        },
        {
          title: 'Authenticity',
          description: 'The system reliably verifies that a request or submission genuinely came from the logged in user\'s own session, not a forged or replayed one.'
        },
        {
          title: 'Resistance',
          description: 'User input is validated and sanitized, including through the system\'s own input handling and prepared database statements, to resist common attacks such as SQL injection and cross site scripting.'
        }
      ]
    },
    {
      title: 'Maintainability',
      items: [
        {
          title: 'Modularity',
          description: 'TrainWise\'s components, such as assessment handling, the recommendation engine, the training demand pipeline, and notifications, are separated enough that one can be changed with limited impact on the others.'
        },
        {
          title: 'Reusability',
          description: 'Shared logic, such as the system\'s self healing database setup routines and notification helpers, is reused across pages instead of being duplicated.'
        },
        {
          title: 'Analysability',
          description: 'When something goes wrong, developers can diagnose the cause quickly using the system\'s error logs and clear code structure.'
        },
        {
          title: 'Modifiability',
          description: 'The system can be updated or extended, such as adjusting the AI recommendation engine\'s scoring or adding a new training status, without unreasonable side effects elsewhere.'
        },
        {
          title: 'Testability',
          description: 'Changes to TrainWise, including updates to the recommendation engine, can be verified through testing before they are relied on.'
        }
      ]
    },
    {
      title: 'Flexibility',
      items: [
        {
          title: 'Adaptability',
          description: 'TrainWise can be adjusted to changing needs, such as new training categories, additional colleges, or new evaluation criteria, without an overhaul of the system.'
        },
        {
          title: 'Scalability',
          description: 'The system\'s architecture can accommodate more employees, colleges, or campuses being added over time without a redesign.'
        },
        {
          title: 'Installability',
          description: 'TrainWise can be installed and configured on a new server, or a local development environment, through a reasonable and well defined set of steps.'
        },
        {
          title: 'Replaceability',
          description: 'Individual parts of the system, such as the hosting provider or the machine learning service, can be swapped out for a comparable alternative with minimal disruption to the rest of the system.'
        }
      ]
    },
    {
      title: 'Safety',
      items: [
        {
          title: 'Operational Constraint',
          description: 'The system enforces clear limits, such as file size and type restrictions and required fields, that prevent accidental misuse or invalid data entry.'
        },
        {
          title: 'Risk Identification',
          description: 'The system flags risky situations to the user, such as warning an employee before a late assessment submission or warning HR before an action that is hard to undo.'
        },
        {
          title: 'Fail Safe',
          description: 'If an unexpected error occurs, the system fails in a safe way, such as rejecting an incomplete action, rather than leaving data in a broken or exposed state.'
        },
        {
          title: 'Hazard Warning',
          description: 'The system gives explicit confirmation prompts before actions that are difficult to reverse, such as rejecting a training demand or cancelling a request.'
        },
        {
          title: 'Safe Integration',
          description: 'The connection to the separate machine learning recommendation service is handled safely, failing gracefully instead of breaking the rest of the system if that service is unavailable.'
        }
      ]
    }
  ];
  sections.forEach(function (section) {
    form.addSectionHeaderItem().setTitle(section.title.toUpperCase());
    section.items.forEach(function (item) {
      form.addScaleItem()
        .setTitle(item.title)
        .setHelpText(item.description)
        .setBounds(1, 5)
        .setLabels('Poor', 'Excellent')
        .setRequired(true);
    });
  });

  Logger.log('Form created successfully.');
  Logger.log('Edit URL (for you): ' + form.getEditUrl());
  Logger.log('Published URL (send this to respondents): ' + form.getPublishedUrl());
}
